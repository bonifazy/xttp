# Скопируйте в .env и заполните строки для своей роли.
# relay — RU: телефон → HAProxy :443 XHTTP → backbone packet-up
# edge — EU для клиентов: HAProxy :EU_SERVER_PORT XHTTP → freedom
# backbone — EU: HAProxy :EU_SERVER_PORT, принимает relay
#
# XHTTP: packet-up — hop/CDN; stream-up — телефон напрямую; auto — inbound.
# stream-one не используем (Vision). Паддинг ядро ставит само.

ROLE="edge"

# Имя этого сервера (SNI, хост в ссылке). На парном relay — EU_SERVER_DOMAIN.
# Апекс (duba1e.newip.dev → newip.dev) — каталог сертификатов ~/newip.dev
# и /etc/ssl/newip.dev. Другой апекс: CERT_DOMAIN="example.com"
DOMAIN_NAME="REGION.nerabotaet.com"

# SUBS_PATH не задаём: main.sh каждый запуск делает случайный путь 12–32 символа.

# Почта Let's Encrypt (если нет /tmp/fullchain.crt + cert.key).
ACME_EMAIL="you@example.com"

# IP через пробел: подписка только им + ufw allow from (все порты).
# Пусто — main.sh не падает, ufw from нет, подписка без ACL. "*" — всем, ufw from нет.
ALLOWED_IP="1.2.3.4"

# Парный backbone (relay, если нет EU_SERVER_LINK).
EU_SERVER_DOMAIN="EUR_REGION.nerabotaet.com"

# Порт туннеля, иначе 443. С RU на :443 часто режут — тогда 8443.
EU_SERVER_PORT=8443

# Hop relay→backbone. По умолчанию packet-up.
# EU_XHTTP_MODE="packet-up"

# #844: на hop RU→EU режем только TLS ClientHello (патч в бинарнике с Mac). 0 — выключить.
# HELLO_FRAG=1
# HELLO_FRAG_LENGTH="80-120"
# HELLO_FRAG_INTERVAL="8-20"

# Relay: постоянная vless-ссылка backbone (обязательна: путь подписки backbone каждый main.sh новый).
# EU_SERVER_LINK="vless://uuid@eu.nerabotaet.com:8443?encryption=none&security=tls&sni=eu.nerabotaet.com&fp=chrome&alpn=h2&type=xhttp&path=%2Fsecret&mode=packet-up"
EU_SERVER_LINK=""

# Ссылка клиенту: stream-up. packet-up только если посередине CDN.
CLIENT_MODE="stream-up"

# DNS: AdGuard Home на 127.0.0.1:5353, UI http://127.0.0.1:3000 (не 80/443).
# Relay: *.ru — DoH Яндекс / 77.88.8.8 с этой машины. Hop — DNS хостера. Остальное с EU.
# Edge/backbone уже в Европе: резолвят сами, :53 из туннеля тоже в этот AdGuard.
# Кеш в RAM: короткий TTL с апстрима поднимаем до ttl_min, чтобы реже звать Яндекс/EU.
# ADGUARD_CACHE_TTL_MIN=86400
# ADGUARD_CACHE_TTL_MAX=0
# ADGUARD_CACHE_SIZE=134217728
