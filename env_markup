# Скопируйте в .env и заполните строки для СВОЕЙ роли.
# ROLE=relay     — RU-мост: HAProxy :443 → XHTTP → VLESS RAW+TLS на backbone
# ROLE=edge      — одиночный EU для клиентов: HAProxy :EU_SERVER_PORT XHTTP → freedom
# ROLE=backbone  — EU-магистраль: Xray :EU_SERVER_PORT VLESS RAW+TLS, принимает relay

ROLE="edge"

# ── Все роли ───────────────────────────────────────────────────────
# Имя ЭТОГО сервера (SAN wildcard-сертификата, SNI, хост в ссылке).
# relay:    ru1.nerabotaet.com  — куда стучится клиент
# edge:     eu1.nerabotaet.com  — куда стучится клиент
# backbone: eu1.nerabotaet.com  — куда стучится relay
#           (это же значение EU_SERVER_DOMAIN на стороне парного relay)
DOMAIN_NAME="REGION.nerabotaet.com"

# Каталог статического файла подписки: /$SUBS_PATH/update_subs_link
# relay/edge:  xttp-ссылка для вашего RestAPI (не для конечных клиентов)
# backbone:    vless RAW+TLS-ссылка, которую relay забирает
#              скриптом from_ru_relay_update_eu_uuid.sh
SUBS_PATH="uuid-каталог-подписки"

# IP через пробел. Подписка отдаётся только им, остальным — как будто пути нет.
# ufw: на каждый IP — allow from <ip> comment "All from allowed_ip" (все порты).
# "*" — подписка открыта всем. ufw на backbone/edge открывает EU_SERVER_PORT.
# relay/edge: IP вашего RestAPI
# backbone:   IP парного relay
ALLOWED_IP="1.2.3.4"

# ── ROLE=relay, ROLE=backbone и ROLE=edge ──────────────────────────
# Имя парного backbone (только relay, если нет EU_SERVER_LINK).
# SNI и flow=xtls-rprx-vision — в коде, либо из EU_SERVER_LINK.
EU_SERVER_DOMAIN="EUR_REGION.nerabotaet.com"

# Порт туннеля. Если не задан — 443.
# backbone: Xray VLESS+TLS и URL подписки
# relay:    outbound на backbone (клиенты по-прежнему стучатся на :443);
#           при EU_SERVER_LINK порт берётся из ссылки
# edge:     HAProxy TLS и порт в клиентской xttp-ссылке
# С RU ALPN на :443 часто режут — тогда 8443.
EU_SERVER_PORT=8443

# ROLE=relay: постоянная vless-ссылка backbone (как отдаёт подписка).
# Если задана — ./main.sh не качает /$SUBS_PATH/update_subs_link.
# Из ссылки: UUID, хост, порт, SNI. EU_SERVER_DOMAIN/PORT тогда не обязательны.
# EU_SERVER_LINK="vless://uuid@eu.nerabotaet.com:8443?type=tcp&encryption=none&flow=xtls-rprx-vision&security=tls&sni=eu.nerabotaet.com&fp=chrome&alpn=http%2F1.1"
EU_SERVER_LINK=""

# ── ROLE=relay и ROLE=edge (клиентская xttp-ссылка) ────────────────
# На сервере XHTTP mode всегда auto (принимает stream-up / packet-up / stream-one).
# В ссылке — stream-up: стриминговый POST по HTTP/2 (alpn=h2), не пачка коротких POST.
# packet-up оставляйте только если посередине CDN/прокси, который режет streaming POST.
CLIENT_MODE="stream-up"
