# Скопируйте в .env и заполните строки для своей роли.
# relay — RU: телефон → HAProxy :CLIENT_PORT XHTTP → backbone packet-up
# edge — EU для клиентов: HAProxy :CLIENT_PORT XHTTP → freedom
# backbone — EU: HAProxy :CLIENT_PORT, принимает relay
#
# XHTTP: packet-up — hop/CDN; stream-up — телефон напрямую; auto — inbound.
# stream-one не используем (Vision). Паддинг ядро ставит само.

ROLE="edge"

# Yandex Cloud CDN: клиент TLS→CDN, CDN HTTP→VPS:18081→HAProxy→Xray.
# В CDN разрешите GET; кеширование отключите; Host к источнику = DOMAIN_NAME.
# Для источника укажите публичный IP VPS и порт CDN_ORIGIN_PORT.
# Yandex по умолчанию блокирует POST, поэтому uplink здесь GET + cookie без тела.
CDN_ENABLED=1
CDN_ORIGIN_PORT=18081
CDN_UPLINK_HTTP_METHOD="GET"
CDN_UPLINK_DATA_PLACEMENT="cookie"
CDN_UPLINK_CHUNK_SIZE=512
CDN_PREFIX_URL="https://tech.cdn.yandex.net/prefixes/yc.json"

# Имя этого сервера (SNI, хост в ссылке). На парном relay — EU_SERVER_DOMAIN.
# Апекс (duba1e.newip.dev → newip.dev) — каталог сертификатов /etc/ssl/newip.dev.
# Другой апекс: CERT_DOMAIN="example.com"
DOMAIN_NAME="REGION.nerabotaet.com"

# SUBS_PATH не задаём: один раз пишет secrets, дальше main.sh его не меняет.

# Почта Let's Encrypt (только при CDN_ENABLED=0, если сертификата ещё нет).
ACME_EMAIL="you@example.com"

# IP через пробел: подписка только им + ufw allow from (все порты).
# Пусто — main.sh не падает, ufw from нет, подписка без ACL. "*" — всем, ufw from нет.
# При CDN подписка ограничена секретным SUBS_PATH и защищена origin allowlist.
# ALLOWED_IP фильтрует IP клиента, которого origin за CDN не видит.
ALLOWED_IP="*"

# Парный backbone (relay, если нет EU_SERVER_LINK).
EU_SERVER_DOMAIN="EUR_REGION.nerabotaet.com"

# Hop relay→backbone (порт в EU_SERVER_LINK). Не слушатель этого VPS.
EU_SERVER_PORT=8443

# Публичный TLS, все роли. Иначе 443. Relay/edge: POST; GET = DOWNLOAD_PORT.
# Пустой DOWNLOAD_PORT: 8443, если CLIENT_PORT уже 8443 — тогда 443. 0 — без split.
# Backbone extra не ставит — hop один XHTTP.
CLIENT_PORT=443
# CDN использует один endpoint для обоих направлений.
DOWNLOAD_PORT=0
# DOWNLOAD_HOST=""

# Раздельный транспорт XHTTP: uplink TCP CLIENT_PORT, downlink HTTP/3 по UDP CLIENT_PORT.
# Включать после подтверждения поддержки QUIC установленной сборкой HAProxy.
XHTTP_H3_DOWNLOAD=0

# Hop relay→backbone. По умолчанию packet-up.
# EU_XHTTP_MODE="packet-up"

# #844: фрагментация только TLS ClientHello (патч в бинарнике с Mac). По умолчанию выключена.
# Set 1 only when explicitly enabling ClientHello fragmentation.
HELLO_FRAG=0
# HELLO_FRAG_LENGTH="80-120"
# HELLO_FRAG_INTERVAL="8-20"

# Relay: постоянная vless-ссылка backbone (обязательна: путь подписки backbone каждый main.sh новый).
# EU_SERVER_LINK="vless://uuid@eu.nerabotaet.com:8443?encryption=none&security=tls&sni=eu.nerabotaet.com&fp=chrome&alpn=h2&type=xhttp&path=%2Fsecret&mode=packet-up"
EU_SERVER_LINK=""

# Ссылка клиенту: при CDN_ENABLED=1 используется packet-up с GET-uplink.
# Без CDN можно вернуть stream-up.
CLIENT_MODE="packet-up"

# DNS: AdGuard Home на 127.0.0.1:5353, UI http://127.0.0.1:3000 (не 80/443).
# Relay: *.ru — DoH Яндекс. Hop — DNS хостера. Остальное — DNS.WATCH.
# Edge/backbone — DNS.WATCH. При сбое используются Google DoH, 8.8.4.4 и 1.1.1.1.
# Edge/backbone уже в Европе: резолвят сами, :53 из туннеля тоже в этот AdGuard.
# Кеш в RAM: короткий TTL с апстрима поднимаем до ttl_min, чтобы реже звать Яндекс/EU.
# ADGUARD_CACHE_TTL_MIN=604800
# ADGUARD_CACHE_TTL_MAX=0
# ADGUARD_CACHE_SIZE=268435456
