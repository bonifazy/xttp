ROLE="edge"

# DOMAIN_NAME="REGION.nerabotaet.com"
# DOMAIN_NAME="REGION.newip.dev"

ALLOWED_IP="31.148.6.240 62.113.113.93 91.212.150.50 93.183.92.89 178.159.94.30 91.201.112.87"

CLIENT_PORT=443
# if you use CDN, set download port: 0.
DOWNLOAD_PORT=0
# DOWNLOAD_HOST=""
# Split tunneling XHTTP: uplink TCP CLIENT_PORT, downlink HTTP/3 UDP CLIENT_PORT.
# Turn on only if QUIC supported by HAProxy.
XHTTP_H3_DOWNLOAD=0

# If CDN_ENABLED=1, project auto set-up mode to packet-up.
CLIENT_MODE="stream-up"

# *** Specific settings! ***

# Yandex Cloud CDN: TLS→CDN, CDN HTTP→VPS:18081→HAProxy→Xray
# CDN_ENABLED=0
# CDN_ORIGIN_PORT=18081
# CDN_UPLINK_HTTP_METHOD="GET"
# CDN_UPLINK_DATA_PLACEMENT="cookie"
# CDN_UPLINK_CHUNK_SIZE=512
# CDN_PREFIX_URL="https://tech.cdn.yandex.net/prefixes/yc.json"

# Set domain without wildcard cert
# ACME_EMAIL="you@example.com"

# current role 'relay': backbone EU_SERVER_LINK="vless://..."
EU_SERVER_LINK=""
# current role 'relay': backbone domain, if EU_SERVER_LINK is not specified
EU_SERVER_DOMAIN="EUR_REGION.nerabotaet.com"
# current role 'relay': EU_SERVER_LINK port
EU_SERVER_PORT=443

# ROLE=edge|relay: WARP_ENABLED=1 → `./warp_setup.sh` (профиль в .warp_secrets). 0 — не трогать.
# Relay: домены из WARP_DOMAINS идут в WARP. Остальное — EU hop, либо весь зарубежный выход в WARP без hop.
WARP_ENABLED=0
WARP_ENDPOINT=8.34.70.140:2408
WARP_DOMAINS="instagram.com,cdninstagram.com,fbcdn.net,ig.me,strava.com,strava-cdn.com,stravausercontent.com"
# YouTube через WARP (правьте список для следующего RU relay):
WARP_DOMAINS="${WARP_DOMAINS},youtube.com,youtu.be,yt.be,youtube-nocookie.com,youtubekids.com,googlevideo.com,ytimg.com,ggpht.com"
WARP_DOMAINS="${WARP_DOMAINS},youtubei.googleapis.com,youtube.googleapis.com,youtubeembeddedplayer.googleapis.com,yt3.googleusercontent.com"


